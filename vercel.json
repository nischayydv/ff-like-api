{
    "version": 2,
    "builds": [
        {
            "src": "./app.py",
            "use": "@vercel/python",
            "config": { "runtime": "python3.8" }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/app.py"
        }
    ]
}

















































































